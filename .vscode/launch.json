    "version": "0.2.0",
    "configurations": [
        {
            "type": "node",
            "request": "launch",
            "name": "Serve",
            "runtimeArgs": [
                "run",
                "serve"
            ],
            "runtimeExecutable": "pnpm",
        },
        {
            "type": "node",
            "request": "launch",
            "name": "Build",
            "runtimeArgs": [
                "run",
                "build"
            ],
            "runtimeExecutable": "pnpm",
            "cwd": "${workspaceFolder}"
            // "program": "vue-cli-service serve",
            // program":${workspaceFolder\index.js
        }
    ]
}